generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuditAction {
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  PATIENT_RECORD_VIEWED
  PATIENT_CREATED
  PATIENT_UPDATED
  ASSESSMENT_CREATED
  MEAL_PLAN_CHANGED
  APPOINTMENT_CHANGED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  CONSENT_GRANTED
  CONSENT_REVOKED
  PROFESSIONAL_REGISTERED
  PROFESSIONAL_APPROVED
  PROFESSIONAL_REJECTED
  PROFESSIONAL_SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
  OTHER
}

enum MealPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  REPLACED
  CANCELLED
}

enum NutrientCategory {
  ENERGY
  MACRO
  LIPID
  VITAMIN
  MINERAL
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
}

enum BmiCategory {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESE_I
  OBESE_II
  OBESE_III
}

enum AssessmentType {
  INITIAL
  FOLLOW_UP
  REASSESSMENT
  DISCHARGE
}

enum BodyFatMethod {
  MANUAL
  DURNIN_WOMERSLEY
  JACKSON_POLLOCK_3
  YUHASZ
}

enum TmbFormula {
  MIFFLIN_ST_JEOR
  HARRIS_BENEDICT
  FAO_OMS
}

enum MacroPreset {
  STANDARD
  HIGH_PROTEIN
  LOW_CARB
  KETOGENIC
  ATHLETIC
  RENAL
  CUSTOM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  roles         Role[]    @default([])
  lastArea      Role?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  patients            Patient[]             @relation("PatientProfessional")
  patientRecords      Patient[]             @relation("PatientAccount")
  appointments        Appointment[]
  assessments         Assessment[]
  mealPlans           MealPlan[]
  professionalProfile ProfessionalProfile?  @relation("ProfileOwner")
  reviewedProfiles    ProfessionalProfile[] @relation("ProfileReviewer")
  invitationsCreated  PatientInvitation[]   @relation("InvitationCreator")
  invitationsAccepted PatientInvitation[]   @relation("InvitationAcceptor")
  consents            PatientConsent[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Patient {
  id                      String        @id @default(cuid())
  firstName               String
  lastName                String
  documentId              String?
  sex                     Sex?
  email                   String?
  phone                   String?
  dateOfBirth             DateTime?
  notes                   String?
  status                  PatientStatus @default(ACTIVE)
  portalMessage           String?
  portalMessageUntil      DateTime?
  progressMessagesEnabled Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  professionalId String
  professional   User                @relation("PatientProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?               @relation("PatientAccount", fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  assessments    Assessment[]
  mealPlans      MealPlan[]
  invitations    PatientInvitation[]
  consents       PatientConsent[]
  auditLogs      AuditLog[]

  @@unique([professionalId, userId])
  @@map("patients")
}

model Assessment {
  id             String         @id @default(cuid())
  type           AssessmentType @default(INITIAL)
  assessmentDate DateTime       @default(now())
  reason         String
  notes          String?
  allergies      String?
  conditions     String?
  medications    String?
  activityLevel  ActivityLevel  @default(SEDENTARY)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patientId      String
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  anthropometry   AnthropometryRecord?
  nutritionalGoal NutritionalGoal?
  mealPlans       MealPlan[]
  dietaryRecalls  DietaryRecall[]

  @@map("assessments")
}

model AnthropometryRecord {
  id             String         @id @default(cuid())
  weightKg       Float
  heightCm       Float
  bodyFatPercent Float?
  bodyFatMethod  BodyFatMethod?
  fatMassKg      Float?
  leanMassKg     Float?
  waistHipRatio  Float?

  // Perímetros
  headCm           Float?
  neckCm           Float?
  chestCm          Float? // Mesoesternal
  waistCm          Float? // Circunferencia de cintura
  abdominalCm      Float? // Circunferencia abdominal (a nivel del ombligo)
  hipCm            Float? // Circunferencia de cadera
  armRelaxedCm     Float? // Perímetro braquial relajado
  armContractedCm  Float? // Mitad de brazo contraído
  forearmCm        Float? // Antebrazo
  wristCm          Float? // Muñeca
  thighProximalCm  Float? // Muslo a 1 cm del pliegue glúteo
  thighCm          Float? // Perímetro de muslo
  calfCm           Float? // Perímetro de pantorrilla
  armMuscleAreaCm2 Float?

  // Pliegues cutáneos (mm)
  skinfoldTricepsMm     Float? // Tricipital
  skinfoldBicepsMm      Float? // Bicipital
  skinfoldSubscapularMm Float? // Subescapular
  skinfoldIliacCrestMm  Float? // Iliocrestal
  skinfoldSuprailiacMm  Float? // Suprailiaco
  skinfoldAbdominalMm   Float? // Abdominal
  skinfoldThighMm       Float? // Muslo frontal
  skinfoldCalfMm        Float? // Pantorrilla medial
  skinfoldMidaxillaryMm Float? // Axilar medial
  skinfoldPectoralMm    Float? // Pectoral

  // Diámetros óseos (cm) — para somatotipo Heath-Carter
  humerusBreadthCm Float? // Biepicondíleo del húmero
  femurBreadthCm   Float? // Biepicondíleo del fémur

  // Somatotipo calculado
  somatotypeEndo Float?
  somatotypeMeso Float?
  somatotypeEcto Float?

  anthropometryNotes String?

  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("anthropometry_records")
}

model NutritionalGoal {
  id          String      @id @default(cuid())
  bmi         Float
  bmiCategory BmiCategory
  tmbKcal     Float
  tmbFormula  TmbFormula  @default(MIFFLIN_ST_JEOR)
  targetKcal  Float
  proteinG    Float
  carbsG      Float
  fatG        Float

  // Distribución de macros personalizable
  macroPreset MacroPreset @default(STANDARD)
  proteinPct  Float       @default(25)
  carbsPct    Float       @default(50)
  fatPct      Float       @default(25)

  // Requerimiento hídrico
  waterMlPerDay Int?
  waterMethod   String?

  // Diagnóstico nutricional automático
  nutritionalDiagnosis String?
  cie10Code            String?

  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("nutritional_goals")
}

model DietaryRecall {
  id         String   @id @default(cuid())
  recallDate DateTime @default(now())
  notes      String?
  isTypical  Boolean  @default(false) // ¿Es un día típico?
  createdAt  DateTime @default(now())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  items DietaryRecallItem[]

  @@map("dietary_recalls")
}

model DietaryRecallItem {
  id                 String  @id @default(cuid())
  mealType           String // BREAKFAST, LUNCH, etc.
  time               String // "07:30"
  foodName           String
  foodId             String? // Enlace opcional al catálogo
  food               Food?   @relation(fields: [foodId], references: [id])
  quantity           Float   @default(1)
  portionDescription String // "1 taza", "2 cucharadas"
  portionGrams       Float
  preparationMethod  String? // "frito", "al horno"
  notes              String?

  recallId String
  recall   DietaryRecall @relation(fields: [recallId], references: [id], onDelete: Cascade)

  @@map("dietary_recall_items")
}

model FoodCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  foods Food[]

  @@map("food_categories")
}

model Nutrient {
  id       String           @id @default(cuid())
  name     String           @unique
  unit     String
  category NutrientCategory
  foods    FoodNutrient[]

  @@map("nutrients")
}

model Food {
  id       String  @id @default(cuid())
  name     String
  source   String  @default("ICBF")
  isGlobal Boolean @default(true)

  categoryId String
  category   FoodCategory @relation(fields: [categoryId], references: [id])

  nutrients   FoodNutrient[]
  portions    FoodPortion[]
  mealItems   MealItem[]
  recallItems DietaryRecallItem[]

  @@map("foods")
}

model FoodNutrient {
  id            String @id @default(cuid())
  amountPer100g Float

  foodId     String
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrientId String
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([foodId, nutrientId])
  @@map("food_nutrients")
}

model FoodPortion {
  id        String  @id @default(cuid())
  name      String
  grams     Float
  isDefault Boolean @default(false)

  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@map("food_portions")
}

model MealPlan {
  id                  String         @id @default(cuid())
  name                String
  notes               String?
  status              MealPlanStatus @default(DRAFT)
  version             Int            @default(1)
  activatedAt         DateTime?
  patientInstructions String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assessmentId   String?
  assessment     Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  professionalId String
  professional   User        @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  days MealPlanDay[]

  @@map("meal_plans")
}

model MealPlanDay {
  id       String @id @default(cuid())
  name     String
  orderNum Int    @default(1)

  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meals      Meal[]

  @@map("meal_plan_days")
}

model Meal {
  id       String   @id @default(cuid())
  type     MealType
  name     String?
  orderNum Int      @default(1)

  dayId String
  day   MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@map("meals")
}

model MealItem {
  id           String  @id @default(cuid())
  quantity     Float   @default(1)
  portionGrams Float
  notes        String?

  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId String
  food   Food   @relation(fields: [foodId], references: [id])

  @@map("meal_items")
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  duration  Int               @default(30)
  reason    String?
  status    AppointmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patientId      String
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ProfessionalProfile {
  id              String             @id @default(cuid())
  licenseNumber   String
  status          ProfessionalStatus @default(PENDING)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  userId       String  @unique
  user         User    @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?   @relation("ProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("professional_profiles")
}

model PatientInvitation {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User    @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedById String?
  acceptedBy   User?   @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("patient_invitations")
}

model ConsentDocument {
  id          String   @id @default(cuid())
  version     String   @unique
  body        String
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  consents PatientConsent[]

  @@map("consent_documents")
}

model PatientConsent {
  id        String    @id @default(cuid())
  grantedAt DateTime  @default(now())
  ip        String?
  userAgent String?
  revokedAt DateTime?

  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  documentId String
  document   ConsentDocument @relation(fields: [documentId], references: [id])

  @@index([patientId, grantedAt])
  @@map("patient_consents")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorRole  Role?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now())

  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
